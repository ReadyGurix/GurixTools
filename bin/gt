#!/bin/bash

# Gurix Tools Entry Point

# Resolve installation directory
# If running from source (e.g. during dev), use relative paths
# If installed, use /usr/local/lib/gurixtools
if [ -d "$(dirname "$0")/../lib" ]; then
    GT_LIB_DIR="$(dirname "$0")/../lib"
    GT_MOD_DIR="$(dirname "$0")/../modules"
else
    GT_LIB_DIR="/usr/local/lib/gurixtools/lib"
    GT_MOD_DIR="/usr/local/lib/gurixtools/modules"
fi

source "$GT_LIB_DIR/colors.sh"
source "$GT_LIB_DIR/utils.sh"
source "$GT_LIB_DIR/tui.sh"
source "$GT_LIB_DIR/distro.sh"

# Load Modules
source "$GT_MOD_DIR/install.sh"
source "$GT_MOD_DIR/iso.sh"
source "$GT_MOD_DIR/system.sh"
source "$GT_MOD_DIR/kvm.sh"
source "$GT_MOD_DIR/files.sh"

VERSION="2.0.0-modular"

show_help() {
    echo -e "${COLOR_PRIMARY}Gurix Tools (gt) v$VERSION${COLOR_RESET}"
    echo "Usage: gt [COMMAND] [OPTIONS]"
    echo
    echo "Commands:"
    echo "  install <pkg>   Install a package"
    echo "  remove <pkg>    Remove a package"
    echo "  update          Update system"
    echo "  iso [list|name] Download ISOs"
    echo "  kvm             Manage KVM"
    echo "  trash <file>    Move file to trash"
    echo "  unzip <file>    Extract archive"
    echo "  size <file>     Show size"
    echo "  self-uninstall  Uninstall Gurix Tools"
    echo "  version         Show version"
    echo "  help            Show this help"
    echo
    echo "Flags:"
    echo "  -i, --install   Alias for install command"
    echo "  -u, --update    Alias for update command"
    echo "  -r, --remove    Alias for remove command"
    echo "  -vm             Alias for kvm command"
}

# Main Logic
if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

case "$1" in
    install|-i|--install)
        shift
        if [ "$1" == "iso" ]; then
            shift
            download_iso "$1"
        else
            install_package "$1"
        fi
        ;;
    remove|-r|--remove)
        shift
        remove_package "$1"
        ;;
    update|-u|--update)
        perform_update
        ;;
    iso)
        shift
        download_iso "$1"
        ;;
    kvm|-vm|--virtual-machine)
        kvm_manager
        ;;
    trash|-tr|--trash)
        shift
        trash_file "$1"
        ;;
    unzip)
        shift
        unzip_file "$1"
        ;;
    size|-s|--size)
        shift
        get_size "$1"
        ;;
    self-uninstall)
        echo
        read -p "Are you sure you want to uninstall Gurix Tools? [y/N] " resp
        if [[ "$resp" =~ ^[Yy]$ ]]; then
            # We can't easily call the uninstall script if it's inside the dir we are deleting
            # So we replicate the logic or call it and hope for the best (it works because script is loaded into memory usually, but safer to just run commands)
            
            echo "Uninstalling..."
            if [ -f "$GT_LIB_DIR/../uninstall.sh" ]; then
                 # If we are running from source/dev
                 "$GT_LIB_DIR/../uninstall.sh"
            else
                 # Installed version
                 sudo rm -f /usr/local/bin/gt
                 sudo rm -rf /usr/local/lib/gurixtools
                 echo "Uninstallation complete."
            fi
            exit 0
        else
            echo "Cancelled."
        fi
        ;;
    version|-v|--version)
        echo "Gurix Tools v$VERSION"
        detect_distro
        echo "Distro: $DISTRO_NAME ($DISTRO_ID)"
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
