#!/bin/bash

# Gurix Tools Entry Point

VERSION="E-2.1.0b"

# Resolve installation directory
# If running from source (e.g. during dev), use relative paths
# If installed, use /usr/local/lib/gurixtools
if [ -d "$(dirname "$0")/../lib" ]; then
    GT_LIB_DIR="$(dirname "$0")/../lib"
    GT_MOD_DIR="$(dirname "$0")/../modules"
else
    GT_LIB_DIR="/usr/local/lib/gurixtools/lib"
    GT_MOD_DIR="/usr/local/lib/gurixtools/modules"
fi

source "$GT_LIB_DIR/colors.sh"
source "$GT_LIB_DIR/utils.sh"
source "$GT_LIB_DIR/tui.sh"
source "$GT_LIB_DIR/distro.sh"

# Load Language
source "$GT_LIB_DIR/lang.sh"
CURRENT_LANG=$(get_configured_language)
load_language "$CURRENT_LANG"

# Load Modules
source "$GT_MOD_DIR/install.sh"
source "$GT_MOD_DIR/iso.sh"
source "$GT_MOD_DIR/system.sh"
source "$GT_MOD_DIR/kvm.sh"
source "$GT_MOD_DIR/files.sh"


show_help() {
    echo -e "${COLOR_PRIMARY}Gurix Tools (gt) v$VERSION${COLOR_RESET}"
    echo "$MSG_USAGE: gt [COMMAND] [OPTIONS]"
    echo
    echo "$MSG_COMMANDS:"
    echo "  install <pkg>   $DESC_INSTALL"
    echo "  remove <pkg>    $DESC_REMOVE"
    echo "  update          $DESC_UPDATE"
    echo "  iso [list|name] $DESC_ISO"
    echo "  kvm             $DESC_KVM"
    echo "  trash <file>    $DESC_TRASH"
    echo "  unzip <file>    $DESC_UNZIP"
    echo "  size <file>     $DESC_SIZE"
    echo "  self-uninstall  $DESC_SELF_UNINSTALL"
    echo "  version         $DESC_VERSION"
    echo "  help            $DESC_HELP"
    echo
    echo "$MSG_FLAGS:"
    echo "  -i, --install   $DESC_FLAG_INSTALL"
    echo "  -u, --update    $DESC_FLAG_UPDATE"
    echo "  -r, --remove    $DESC_FLAG_REMOVE"
    echo "  -vm             $DESC_FLAG_VM"
}

# Main Logic
if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

case "$1" in
    install|-i|--install)
        shift
        if [ "$1" == "iso" ]; then
            shift
            download_iso "$1"
        else
            install_package "$1"
        fi
        ;;
    remove|-r|--remove)
        shift
        remove_package "$1"
        ;;
    update|-u|--update)
        perform_update
        ;;
    iso)
        shift
        download_iso "$1"
        ;;
    kvm|-vm|--virtual-machine)
        kvm_manager
        ;;
    trash|-tr|--trash)
        shift
        trash_file "$1"
        ;;
    unzip)
        shift
        unzip_file "$1"
        ;;
    size|-s|--size)
        shift
        get_size "$1"
        ;;
    self-uninstall)
        echo
        read -p "$MSG_CONFIRM_UNINSTALL" resp
        if [[ "$resp" =~ ^[Yy]$ ]]; then
            # We can't easily call the uninstall script if it's inside the dir we are deleting
            # So we replicate the logic or call it and hope for the best (it works because script is loaded into memory usually, but safer to just run commands)
            
            echo "$MSG_UNINSTALLING"
            if [ -f "$GT_LIB_DIR/../uninstall.sh" ]; then
                 # If we are running from source/dev
                 "$GT_LIB_DIR/../uninstall.sh"
            else
                 # Installed version
                 sudo rm -f /usr/local/bin/gt
                 sudo rm -rf /usr/local/lib/gurixtools
                 echo "$MSG_UNINSTALL_COMPLETE"
            fi
            exit 0
        else
            echo "$MSG_CANCELLED"
        fi
        ;;
    version|-v|--version)
        show_banner "Gurix Tools"
        echo -e "  ${COLOR_PRIMARY}Version:${COLOR_RESET} $VERSION"
        detect_distro
        echo -e "  ${COLOR_PRIMARY}Distro:${COLOR_RESET}  $DISTRO_NAME ($DISTRO_ID)"
        echo -e "  ${COLOR_PRIMARY}Author:${COLOR_RESET}  Gurix"
        echo -e "  ${COLOR_PRIMARY}License:${COLOR_RESET} Apache License Version 2.0"
        echo
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "$MSG_UNKNOWN_CMD: $1"
        show_help
        exit 1
        ;;
esac
